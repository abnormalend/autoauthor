# These are for the standalone image tools at the repo root ONLY.
# The plugin itself needs no API keys — it runs inside Claude Code.

# Anthropic API key, used by gen_art.py and gen_art_directions.py to write
# the art direction prompts.
ANTHROPIC_API_KEY=sk-ant-...

# Model and endpoint for those two scripts.
AUTOAUTHOR_WRITER_MODEL=claude-sonnet-4-6
AUTOAUTHOR_API_BASE_URL=https://api.anthropic.com

# fal.ai key — the actual image generation.
FAL_KEY=your-fal-api-key-here
